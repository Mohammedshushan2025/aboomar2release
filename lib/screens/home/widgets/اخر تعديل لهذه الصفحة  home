    // تم إزالة RefreshIndicator من هنا لأنه أصبح يغلف الشاشة بأكملها
    return Column(
      children: [
        // مؤشر الأداء اليومي
        DailyPerformanceWidget(summary: dailySummary),

        // أعلى 5 فروع
        if (topBranches.isNotEmpty)
          TopBranchesChart(branches: topBranches),

        // تطور الإيراد
        if (revenue7Days.isNotEmpty)
          RevenueTrendChart(revenues: revenue7Days),

        // الشكل البياني الدائري لإجمالي المبيعات - إضافة جديدة
        if (salesCategories.isNotEmpty)
          SalesPieChartWidget(categories: salesCategories),

        // كروت الإجراءات
        HomeActionCards(selectedDate: _selectedDate),
      ],
    );
  }
